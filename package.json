{
  "name": "medico_backend",
  "version": "1.0.0",
  "description": "MediShop Backend Server",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent jest",
    "postinstall": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.8.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^18.16.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
